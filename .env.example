# Postgres superuser (faqat admin ishlari uchun, ilovalar bunda ulanmaydi)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme-admin-strong-password
POSTGRES_PORT=5432

# Yaratiladigan loyihalar (har biriga shu nomdagi user yaratiladi va u DB egasi bo'ladi).
# Faqat birinchi marta postgres ishga tushganda init script ta'sir qiladi.
# Mavjud volume'da yangi qo'shilgan nom uchun DB qo'lda yaratilishi kerak.
INIT_DATABASES=familytree,portify

# Har bir loyiha uchun parol — DB_<NAME>_PASSWORD formatida.
# Loyiha o'z `.env` faylida shu parolni POSTGRES_PASSWORD sifatida ishlatadi.
DB_FAMILYTREE_PASSWORD=changeme-familytree-strong-password
DB_PORTIFY_PASSWORD=changeme-portify-strong-password
